NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never exposed to the browser. Used to write payment
# confirmations after independently verifying with Stripe (never trusts
# the client). Never commit a real value here.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Used to create Connect accounts, checkout sessions, and
# verify payments.
STRIPE_SECRET_KEY=

# Currently unused in code (checkout uses Stripe-hosted redirect, not
# Stripe.js), kept for when/if Elements gets added.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
